# Copy to supabase/functions/.env for `supabase functions serve`; set in the dashboard for deployed functions.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
WORKER_SECRET=            # same value as the Vault secret 'worker_secret'
MIN_SUPPORTED_APP_VERSION=1.0.0
# Optional per-task model overrides (default claude-opus-5-5), e.g. AI_MODEL_RESUME_PARSE=claude-haiku-5-5
